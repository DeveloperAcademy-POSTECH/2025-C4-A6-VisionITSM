#usda 1.0
(
    customLayerData = {
        dictionary RealityKit = {
            bool expandRootVariants = 1
        }
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root" (
    customData = {
        float3 rotationEulerHint = (0, 0, 0)
    }
