#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    reorder nameChildren = ["GridMaterial", "visionitsmSkybox", "potato_1", "potato_2", "potato_3", "potato_4", "potato_5"]
    def "GridMaterial" (
        active = true
        references = @Materials/GridMaterial.usda@
    )
    {
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "visionitsmSkybox" (
        active = true
        references = @visionitsmSkybox.usdz@
    )
    {
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "SkySphere"
        {
            over "SkySphere_mat"
            {
                asset inputs:SkySphere_Texture = @visionitsmSkybox1.jpeg@
            }
        }
    }

    def "potato_1" (
        active = true
        customData = {
            float3 rotationEulerHint = (-1.5707961, 0, -3.7827583e-8)
        }
        references = @potato2.usdz@
    )
    {
        quatf xformOp:orient = (0.7071068, -0.7071067, 1.337407e-8, -1.3374072e-8)
        float3 xformOp:scale = (0.15, 0.15, 0.15)
        float3 xformOp:translate = (0, 0, -3)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "potato_2" (
        active = true
        customData = {
            float3 rotationEulerHint = (-1.5707965, 0.17453292, 1.8157243e-7)
        }
        references = @potato2.usdz@
    )
    {
        quatf xformOp:orient = (0.704416, -0.7044161, 0.06162835, 0.061628487)
        float3 xformOp:scale = (0.15, 0.15, 0.15)
        float3 xformOp:translate = (-0.5, 0, -2.8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Area_002"
        {
        }

        over "Area_001"
        {
        }

        over "Area"
        {
        }

        over "Camera"
        {
        }

        over "Armature"
        {
        }

        over "Sphere"
        {
        }

        over "_materials"
        {
        }

        over "Empty_002"
        {
        }

        over "env_light"
        {
        }
    }

    def "potato_3" (
        active = true
        customData = {
            float3 rotationEulerHint = (-1.5707965, 0.2617994, 0)
        }
        references = @potato3.usdz@
    )
    {
        quatf xformOp:orient = (0.7010573, -0.70105743, 0.092295945, 0.09229596)
        float3 xformOp:scale = (0.15, 0.15, 0.15)
        float3 xformOp:translate = (-1, 0, -2.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "potato_4" (
        active = true
        customData = {
            float3 rotationEulerHint = (-1.5707965, -0.17453292, -1.0591725e-7)
        }
        references = @potato.usdz@
    )
    {
        quatf xformOp:orient = (0.704416, -0.7044161, -0.061628375, -0.06162846)
        float3 xformOp:scale = (0.15, 0.15, 0.15)
        float3 xformOp:translate = (0.5, 0, -2.8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "potato_5" (
        active = true
        customData = {
            float3 rotationEulerHint = (-1.5707966, -0.2617994, -9.25609e-8)
        }
        references = @potato4.usdz@
    )
    {
        quatf xformOp:orient = (0.70105726, -0.7010575, -0.09229591, -0.092296004)
        float3 xformOp:scale = (0.15, 0.15, 0.15)
        float3 xformOp:translate = (1, 0, -2.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "SpawnSlidePosition" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Root/SpawnSlidePosition/DefaultMaterial>
        double size = 0.2
        float2 ui:nodegraph:node:pos = (20, 20)
        int ui:nodegraph:node:stackingOrder = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1.7, 1.7, 1.7)
        float3 xformOp:translate = (0, 0.8, 2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Material "DefaultMaterial"
        {
            token outputs:mtlx:surface
            token outputs:realitykit:vertex
            token outputs:surface.connect = </Root/SpawnSlidePosition/DefaultMaterial/DefaultSurfaceShader.outputs:surface>

            def Shader "DefaultSurfaceShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                float inputs:opacity = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }
    }
}

