#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    reorder nameChildren = ["GridMaterial", "visionitsmSkybox", "potato_1", "potato_2", "potato_3", "potato_4", "potato_5", "SpawnSlidePosition", "SpatialAudio2"]
    def "GridMaterial" (
        active = true
        references = @Materials/GridMaterial.usda@
    )
    {
        float3 xformOp:scale = (1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "visionitsmSkybox" (
        active = true
        references = @visionitsmSkybox.usdz@
    )
    {
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "SkySphere"
        {
            over "SkySphere_mat"
            {
                asset inputs:SkySphere_Texture = @visionitsmSkybox1.jpeg@
            }
        }
    }

    def "potato_1" (
        active = true
        customData = {
            float3 rotationEulerHint = (-1.5707961, 0, -3.7827583e-8)
        }
        references = @potato2.usdz@
    )
    {
        quatf xformOp:orient = (0.7071068, -0.7071067, 1.337407e-8, -1.3374072e-8)
        float3 xformOp:scale = (6, 6, 6)
        float3 xformOp:translate = (19.550434, -42.425, -48.028374)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "potato_2" (
        active = true
        customData = {
            float3 rotationEulerHint = (-1.5707965, -0.17453292, 1.8913795e-7)
        }
        references = @potato2.usdz@
    )
    {
        quatf xformOp:orient = (0.704416, -0.7044161, -0.06162848, -0.06162836)
        float3 xformOp:scale = (6, 6, 6)
        float3 xformOp:translate = (41.232155, -42.425, -38.75045)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Area_002"
        {
        }

        over "Area_001"
        {
        }

        over "Area"
        {
        }

        over "Camera"
        {
        }

        over "Armature"
        {
        }

        over "Sphere"
        {
        }

        over "_materials"
        {
        }

        over "Empty_002"
        {
        }

        over "env_light"
        {
        }
    }

    def "potato_3" (
        active = true
        customData = {
            float3 rotationEulerHint = (-1.5707965, 0.52359873, 1.720638e-8)
        }
        references = @potato3.usdz@
    )
    {
        quatf xformOp:orient = (0.6830126, -0.6830128, 0.18301266, 0.18301272)
        float3 xformOp:scale = (6, 6, 6)
        float3 xformOp:translate = (-27.405228, -42.425, -43.72101)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "potato_4" (
        active = true
        customData = {
            float3 rotationEulerHint = (-1.5707965, 0.17453292, -1.0591725e-7)
        }
        references = @potato.usdz@
    )
    {
        quatf xformOp:orient = (0.704416, -0.7044161, 0.06162845, 0.061628386)
        float3 xformOp:scale = (6, 6, 6)
        float3 xformOp:translate = (-4.5550575, -42.667614, -51.376167)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "potato_5" (
        active = true
        customData = {
            float3 rotationEulerHint = (-1.5707967, 0.6981317, -7.780833e-8)
        }
        references = @potato4.usdz@
    )
    {
        quatf xformOp:orient = (0.6644629, -0.66446316, 0.24184473, 0.24184477)
        float3 xformOp:scale = (6, 6, 6)
        float3 xformOp:translate = (-46.286022, -42.425, -22.755333)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "SpawnSlidePosition" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Root/SpawnSlidePosition/DefaultMaterial>
        double size = 0.2
        float3 xformOp:translate = (6.3455067, 8.928434, 55.658283)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Material "DefaultMaterial"
        {
            token outputs:mtlx:surface
            token outputs:realitykit:vertex
            token outputs:surface.connect = </Root/SpawnSlidePosition/DefaultMaterial/DefaultSurfaceShader.outputs:surface>

            def Shader "DefaultSurfaceShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                float inputs:opacity = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }
    }
}

