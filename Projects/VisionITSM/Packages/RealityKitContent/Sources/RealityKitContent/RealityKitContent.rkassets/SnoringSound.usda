#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (448.120.2)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    quatf xformOp:orient = (1, 0, 0, 0)
    float3 xformOp:scale = (1, 1, 1)
    float3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def Xform "SpatialAudio" (
        customData = {
            float3 rotationEulerHint = (3.1415927, 0, 0)
        }
    )
    {
        reorder nameChildren = ["SnoringSound_wav", "SpatialAudio"]
        quatf xformOp:orient = (-4.371139e-8, 1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "SpatialAudio"
        {
            float directivityFocus = 0
            float directLevel = 0
            float gain = 0
            uniform token info:id = "RealityKit.SpatialAudio"
            float reverbLevel = 0
        }

        def RealityKitAudioFile "SnoringSound_wav"
        {
            uniform asset file = @SnoringSound.wav@
            uniform bool shouldLoop = 1
        }
    }
}

